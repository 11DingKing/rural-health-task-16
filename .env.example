# Example environment variables for the rehabilitation device certification platform.
# Copy to .env and adjust as needed. Do not commit real credentials.

# HTTP server
CERT_HTTP_ADDR=:52661
CERT_DATA_DIR=./data
CERT_SIGNING_KEY=change-this-in-production

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Timeouts (Go duration format)
CERT_READ_TIMEOUT=30s
CERT_WRITE_TIMEOUT=30s
